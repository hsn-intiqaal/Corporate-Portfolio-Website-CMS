# ---------- Required ----------
# PostgreSQL connection string (Neon, Supabase, RDS, or local)
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------- Media storage (optional, required on Vercel) ----------
# Any S3-compatible bucket: Cloudflare R2, AWS S3, Backblaze B2, DigitalOcean Spaces.
# Leave empty to store uploads on local disk (./media and ./lead-files) - fine on a VPS with a volume.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (e.g. https://media.example.com) - used for next/image
S3_PUBLIC_URL=

# ---------- Email (optional) ----------
# Any SMTP provider: Resend (smtp.resend.com), Postmark, AWS SES, Brevo...
# If empty, emails are printed to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Company Website

# ---------- Spam protection (optional but recommended) ----------
# Cloudflare Turnstile keys: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Analytics (optional) ----------
# e.g. G-XXXXXXX. When set, the consent banner is shown and the script loads only after consent.
NEXT_PUBLIC_GA_ID=

# ---------- Seeding ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ---------- Limits ----------
# Total size of quotation attachments per submission, in MB. Set to 4 on Vercel (4.5 MB request limit).
LEAD_UPLOAD_TOTAL_MB=15
# Secret for the scheduled-publishing cron on Vercel (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ---------- Self-managed server (deploy/docker-compose.yml) ----------
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
# Set to "staging" on a staging server so search engines do not index it
SITE_ENV=production
BACKUP_KEEP_DAYS=14
